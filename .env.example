# Settings for the online version (the cloud machine). On your own PC you need none of these:
# with ACCOUNTS unset there is no login and files live in ./storage.

# Invited accounts: username:scrypt$… entries, separated by commas. Make each line with
#   npm run add-user -- <username>
ACCOUNTS=

# A random secret of 32+ characters that signs login cookies (required when ACCOUNTS is set):
#   node -e "console.log(require('crypto').randomBytes(36).toString('base64url'))"
SESSION_SECRET=

# Where the app keeps songs, pictures and exports (the cloud machine's kept disk).
STORAGE_DIR=

# 1 = let Chrome use the cloud machine's NVIDIA GPU for exports.
RENDER_GPU=

# The one-off GPU check render at start-up runs on the online version (ACCOUNTS set):
# 0 = skip it, 1 = run it anyway (e.g. on your PC, to try it).
GPU_CHECK=
