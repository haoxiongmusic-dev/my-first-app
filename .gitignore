# Secrets: never commit these
.env
.env.*
!.env.example

# Dependencies
node_modules/
.venv/
venv/
__pycache__/
.pytest_cache/

# Build output
dist/
build/
.next/
out/
coverage/

# Logs
*.log
npm-debug.log*

# OS and editor files
.DS_Store
Thumbs.db
desktop.ini
.vscode/*
!.vscode/settings.json
!.vscode/extensions.json
.idea/

# Local test renders (large video files)
test-renders/

# Next.js / Node extras (from create-next-app)
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*
*.pem
.vercel
*.tsbuildinfo
next-env.d.ts

# App data (songs, analysis, renders): never commit
storage/

# Local agent workspace (plan progress ledgers)
.superpowers/

# Music and video: never commit (the repo is public).
# If tests ever need a tiny generated clip, allow it narrowly, e.g. !analyzer/tests/fixtures/*.wav
*.wav
*.mp3
*.flac
*.m4a
*.aac
*.ogg
*.mp4
*.mov
*.webm

# Claude Code local settings (may hold personal paths or tokens)
.claude/settings.local.json

# Template dev data made from a song (npm run template:assets): never commit
templates/*/assets/audio-data.js
