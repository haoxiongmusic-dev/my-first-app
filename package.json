{
  "name": "my-first-app",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "test": "vitest run",
    "test:watch": "vitest",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "setup:py": "tsx scripts/setup-py.ts",
    "test:py": "tsx scripts/py.ts -m pytest -c analyzer/pytest.ini",
    "doctor": "tsx scripts/doctor.ts",
    "typecheck": "tsc --noEmit",
    "check": "npm run lint && npm run format:check && npm run typecheck && npm test && npm run test:py",
    "analyze": "tsx scripts/analyze.ts",
    "sync:toolkit": "tsx scripts/sync-toolkit.ts",
    "template:assets": "tsx scripts/template-assets.ts",
    "check:templates": "tsx scripts/check-templates.ts",
    "render": "tsx scripts/render.ts"
  },
  "dependencies": {
    "next": "16.4.5",
    "react": "19.3.0",
    "react-dom": "19.3.0"
  },
  "devDependencies": {
    "@tailwindcss/turbopack": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.4.5",
    "eslint-config-prettier": "^10.1.8",
    "hyperframes": "0.9.10",
    "prettier": "^3.9.10",
    "tailwindcss": "^4",
    "tsx": "^4.23.15",
    "typescript": "^5",
    "vitest": "^4.1.12"
  }
}
